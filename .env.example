# ---------------------------------------------------------------- application
ANS_ENVIRONMENT=development
ANS_DEBUG=false
ANS_LOG_LEVEL=INFO
ANS_LOG_JSON=true
ANS_APP_VERSION=0.1.0

# ---------------------------------------------------------------- database
ANS_DATABASE_URL=postgresql+psycopg://security:security@postgres:5432/security
POSTGRES_USER=security
POSTGRES_PASSWORD=security
POSTGRES_DB=security
POSTGRES_PORT=5432

# ------------------------------------------------------------ credentials
# CHANGE ME: derives the credential-encryption key. Rotating it makes existing
# repository tokens unreadable, so store it securely.
ANS_SECRET_KEY=change-me-in-production
# Optional separate key material for encrypting repository tokens.
# ANS_CREDENTIAL_KEY=

# ---------------------------------------------------------------- auth
# Enable API-key auth before exposing the platform beyond localhost.
ANS_AUTH_ENABLED=false
ANS_API_KEYS=
ANS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------------------------------------------------------------- storage
ANS_STORAGE_BACKEND=local
ANS_STORAGE_ROOT=/app/var/sboms
ANS_WORKSPACE_ROOT=/app/var/workspaces
ANS_KEEP_WORKSPACES=false

# ---------------------------------------------------------------- scanners
ANS_SCANNERS_ENABLED=trivy,semgrep,gitleaks,syft
ANS_ALLOWED_GIT_HOSTS=github.com,gitlab.com
ANS_GIT_CLONE_TIMEOUT_SECONDS=900
ANS_SCANNER_TIMEOUT_SECONDS=1800
ANS_SEMGREP_CONFIG=p/security-audit
ANS_TRIVY_BINARY=trivy
ANS_SEMGREP_BINARY=semgrep
ANS_GITLEAKS_BINARY=gitleaks
ANS_SYFT_BINARY=syft

# ------------------------------------------------------ vulnerability feeds
ANS_VULN_SYNC_ENABLED=true
ANS_OSV_API_URL=https://api.osv.dev
ANS_NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# Optional NVD API key: raises the rate limit from 5 to 50 req/30s.
ANS_NVD_API_KEY=
ANS_NVD_INITIAL_LOOKBACK_DAYS=7
ANS_NVD_MAX_PAGES_PER_SYNC=20
ANS_KEV_CATALOG_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# ---------------------------------------------------------------- scheduling
ANS_SCHEDULER_ENABLED=true
ANS_SCANNER_SCHEDULE_INTERVAL_MINUTES=240
ANS_OSV_SYNC_INTERVAL_MINUTES=720
ANS_NVD_SYNC_INTERVAL_MINUTES=1440
ANS_KEV_SYNC_INTERVAL_MINUTES=1440

# ---------------------------------------------------------------- frontend
VITE_API_BASE_URL=/api/v1

# ------------------------------------------------------------------- AI layer
# Off by default. Without a key the platform behaves exactly as before and the
# AI endpoints return 503 ai_unavailable.
ANS_AI_ENABLED=false
ANS_AI_PROVIDER=openai
ANS_AI_MODEL=gpt-4.1-mini
# ANS_AI_API_KEY=
ANS_AI_BASE_URL=https://api.openai.com/v1
# Extra routing headers for OpenAI-compatible gateways (JSON object).
# Wrap JSON in single quotes: python-dotenv strips unquoted braces.
# ANS_AI_EXTRA_HEADERS='{"x-session":"ai-native-security"}'
ANS_AI_TIMEOUT_SECONDS=90
ANS_AI_MAX_RETRIES=3
ANS_AI_RETRY_BACKOFF_SECONDS=2
ANS_AI_REQUESTS_PER_MINUTE=30
ANS_AI_MAX_INPUT_CHARS=24000
ANS_AI_MAX_OUTPUT_TOKENS=2000
ANS_AI_TEMPERATURE=0.1
ANS_AI_DAILY_BUDGET_USD=5
# Fallback price table when the provider does not report a cost.
ANS_AI_PRICE_INPUT_PER_1K=0
ANS_AI_PRICE_OUTPUT_PER_1K=0
# Data sharing: source snippets are redacted before leaving the process.
ANS_AI_ALLOW_SOURCE_SHARING=true
ANS_AI_MAX_SNIPPET_CHARS=1200
ANS_AI_MAX_SNIPPETS=5
ANS_AI_CONTEXT_MAX_EVIDENCE=40
ANS_AI_CONTEXT_VERSION=1
# Opt-in only: prompts can contain repository text.
ANS_AI_STORE_PROMPTS=false
ANS_AI_ASSISTANT_MAX_TOOL_CALLS=6
ANS_AI_AUTO_ANALYZE=true
ANS_AI_AUTO_ANALYZE_MAX_FINDINGS=10
ANS_AI_AUTO_ANALYZE_MIN_SEVERITY=HIGH

# --------------------------------------------------------------------- EPSS
ANS_EPSS_ENABLED=true
ANS_EPSS_SYNC_INTERVAL_MINUTES=1440

# ------------------------------------------------------- code evidence capture
ANS_CAPTURE_CODE_SNIPPETS=true
ANS_MAX_SNIPPET_LINES=40
ANS_MAX_SNIPPET_FILES=200

# ---------------------------------------------------------- asset-level auth
# Optional per-key asset restriction: {"1": ["<asset-uuid>"]} maps the 1-based
# index in ANS_API_KEYS to the assets that key may read.
# ANS_API_KEY_SCOPES={}
